generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model ContactRequest {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  subject   String
  email     String
  message   String
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?

  image                 String?
  password              String?
  passwordResetToken    String?   @unique
  passwordResetTokenExp DateTime?
  deletedAt             DateTime?

  hasCompletedOnboardingAt DateTime?

  trialStartedAt DateTime  @default(now())
  trialEndsAt    DateTime?

  accounts Account[]

  sessions Session[]

  signedUpAt                 DateTime                   @default(now())
  lastActivityAt             DateTime                   @default(now())
  userNotificationSettings   UserNotificationSettings?
  reminderSettings           UserReminderSettings?
  changePasswordTokens       ChangePasswordToken[]
  subscription               Subscription?
  featureAccess              UserFeatureAccess?
  changeEmailTokens          ChangeEmailToken[]
  feedbacks                  Feedback[]
  userSetupChecklist         UserSetupChecklist?
  userQuickStartActions      UserQuickStartActions?
  templates                  Template[]
  clients                    Client[]
  googleDriveAccount         GoogleDriveAccount?
  reminders                  Reminder[]
  sentReminders              SentReminder[]
  activityLogs               ActivityLog[]
  templateAssignationBatches TemplateAssignationBatch[]
  branding                   UserBranding?
}

model GoogleDriveAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  folderId   String?
  folderName String?

  userName    String?
  userEmail   String?
  userPicture String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSetupChecklist {
  id     String @id @default(cuid())
  userId String @unique

  firstLocationAdded   Boolean @default(true)
  aiRepliesEnabled     Boolean @default(true)
  enabledNotifications Boolean @default(false)
  refinedBrandVoice    Boolean @default(false)
  addedAnotherLocation Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserQuickStartActions {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdFirstTemplate   Boolean @default(false)
  addedFirstClient       Boolean @default(false)
  connectedGoogleDrive   Boolean @default(false)
  createdDocumentRequest Boolean @default(false)
  sentFirstRequest       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChangeEmailToken {
  id            String    @id @default(cuid())
  userId        String
  newEmail      String
  createdAt     DateTime  @default(now())
  changedAt     DateTime?
  invalidatedAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserFeatureAccess {
  id     String @id @default(cuid())
  userId String @unique

  workspacesLimit              Int?    @default(3)
  workspaceLinksLimit          Int?    @default(20)
  workspaceDashboardPageAccess Boolean @default(false)
  groupsAccess                 Boolean @default(false)
  autoSnapshotsAccess          Boolean @default(false)
  snapshotDaysRetention        Int     @default(5)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String?            @unique
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  stripePriceId        String?
  type                 SubscriptionType
  status               SubscriptionStatus
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?

  subscriptionStartedAt  DateTime?
  subscriptionCanceledAt DateTime?

  cancellationReason  String?
  cancelationFeedback String?

  priceId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Feedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    String
  category  String
  feedback  String
}

enum SubscriptionType {
  FREE
  PRO
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELLED
  PAYMENT_FAILED
}

enum SubscriptionPeriod {
  MONTHLY
  YEARLY
}

model UserNotificationSettings {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  importantNotifications Boolean @default(true)
  marketingEmails        Boolean @default(true)
  devUpdates             Boolean @default(true)
}

model UserReminderSettings {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderName  String @default("Tabzo")
  sendingHour Int    @default(9)
}

model ChangePasswordToken {
  id            String    @id @default(cuid())
  userId        String
  createdAt     DateTime  @default(now())
  changedAt     DateTime?
  invalidatedAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TemplateClientAssignation {
  id          String                 @id @default(cuid())
  name        String?
  templateId  String                 @unique
  clientId    String
  assignedAt  DateTime               @default(now())
  dueDate     DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  status      AssignedTemplateStatus @default(DRAFT)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  completedFieldsCount   Int @default(0)
  completedSectionsCount Int @default(0)

  totalFieldsCount         Int @default(0)
  totalRequiredFieldsCount Int @default(0)
  totalSectionsCount       Int @default(0)

  completionValues FieldCompletionValue[]

  lastActivityAt DateTime?

  spreadsheetId       String?
  templateFolderId    String?
  clientFolderId      String?
  clientSummaryFileId String?
  reminders           Reminder[]
  sentReminders       SentReminder[]
  activityLogs        ActivityLog[]

  buildStep Int @default(0)
}

model Template {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String?
  headerImage String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections TemplateSection[]

  totalSections  Int @default(0)
  totalFields    Int @default(0)
  requiredFields Int @default(0)

  templateClientAssignation TemplateClientAssignation?

  assignationParentTemplateId String?
  assignationParentTemplate   Template?                  @relation("TemplateAssignationParent", fields: [assignationParentTemplateId], references: [id], onDelete: SetNull)
  assignationChildren         Template[]                 @relation("TemplateAssignationParent")
  assignationBatches          TemplateAssignationBatch[]
}

enum AssignedTemplateStatus {
  DRAFT
  ASSIGNED
  COMPLETED
  IN_PROGRESS
  OVERDUE
}

model TemplateSection {
  id         String @id @default(cuid())
  templateId String
  name       String @default("Untitled Section")
  order      Int    @default(0)

  template Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields   TemplateField[]
}

model TemplateField {
  id          String  @id @default(cuid())
  sectionId   String
  name        String
  description String?
  placeholder String?

  type     TemplateFieldType
  required Boolean           @default(false)
  order    Int               @default(0)

  // File/Image fields
  allowMultiple Boolean @default(false)

  // Text fields
  characterLimit Int?

  section         TemplateSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completionValue FieldCompletionValue?
}

enum TemplateFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  URL
  NUMBER
  FILE
  IMAGE
}

model Client {
  id      String  @id @default(cuid())
  name    String
  company String?
  email   String?
  phone   String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  templateClientAssignations TemplateClientAssignation[]
  assignationBatches         TemplateAssignationBatchClient[]
}

model FieldCompletionValue {
  id String @id @default(cuid())

  fieldId       String @unique
  assignationId String

  value String?

  files File[]

  field       TemplateField             @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  assignation TemplateClientAssignation @relation(fields: [assignationId], references: [id], onDelete: Cascade)

  updatedAt    DateTime      @default(now()) @updatedAt
  activityLogs ActivityLog[]

  @@unique([fieldId, assignationId])
}

model File {
  id        String   @id @default(cuid())
  fileName  String
  fileType  String
  fileSize  Int
  s3Key     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldCompletionValue   FieldCompletionValue? @relation(fields: [fieldCompletionValueId], references: [id])
  fieldCompletionValueId String?
  driveFileUrl           String?

  @@index([s3Key])
}

model Reminder {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title String

  scheduleType ReminderScheduleType
  everyDays    Int?
  afterDays    Int?

  reminderType ReminderType

  subject String
  content String

  assignmentId String?
  assignment   TemplateClientAssignation? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  batchId String?
  batch   TemplateAssignationBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  activityLogs  ActivityLog[]
  sentReminders SentReminder[]
}

model SentReminder {
  id            String   @id @default(cuid())
  reminderId    String
  assignmentId  String
  occurrenceKey String
  sentAt        DateTime @default(now())
  providerId    String?

  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  reminder   Reminder                  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  assignment TemplateClientAssignation @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([reminderId, assignmentId, occurrenceKey])
  @@index([userId, sentAt])
}

enum ReminderScheduleType {
  AFTER
  EVERY
}

enum ReminderType {
  ASSIGNMENT_STARTED // send on the day the assignment is submitted
  ASSIGNMENT_REMINDER // send on a specific date difference or interval
  ASSIGNMENT_DUE_SOON // send a reminder a few days before the assignment is due
  ASSIGNMENT_OVERDUE // send on day after the assignment is overdue
  ASSIGNMENT_OVERDUE_REMINDER // send a reminder a few days after the assignment is overdue or interval
  ASSIGNMENT_COMPLETED // send on the day the assignment is completed
}

model ActivityLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignationId String?
  assignation   TemplateClientAssignation? @relation(fields: [assignationId], references: [id], onDelete: SetNull)

  fieldCompletionValueId String?
  fieldCompletionValue   FieldCompletionValue? @relation(fields: [fieldCompletionValueId], references: [id], onDelete: SetNull)

  reminderId String?
  reminder   Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  action      String?
  title       String?
  description String?
  createdAt   DateTime @default(now())

  type ActivityLogType @default(CLIENT_FIELD_UPDATE)
}

enum ActivityLogType {
  REMINDER
  CLIENT_FIELD_UPDATE
}

model TemplateAssignationBatch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  currentStep Int                            @default(0)
  status      TemplateAssignationBatchStatus @default(DRAFT)

  clients   TemplateAssignationBatchClient[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([templateId])
}

model TemplateAssignationBatchClient {
  id      String                   @id @default(cuid())
  batchId String
  batch   TemplateAssignationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  dueDate DateTime?
  order   Int       @default(0)

  @@unique([batchId, clientId])
  @@index([clientId])
}

enum TemplateAssignationBatchStatus {
  DRAFT
  SUBMITTED
}

model UserBranding {
  id     String @id @default(cuid())
  userId String @unique

  // Portal identity
  name    String?
  logoUrl String?
  logoKey String?

  // Colors
  backgroundColor            String @default("#0d1420")
  headerFooterColor          String @default("#0f172a")
  primaryColor               String @default("#6366f1")
  fieldBackgroundColor       String @default("#0a0f1c")
  sectionCardBackgroundColor String @default("#0f172a")

  // Text colors
  sectionTitleColor  String @default("#f8fafc")
  fieldTitleColor    String @default("#f1f5f9")
  fieldSubtitleColor String @default("#94a3b8")

  // Input colors
  inputBackgroundColor  String @default("#111a2b")
  uploadBackgroundColor String @default("#0d1420")

  // Layout
  borderRadius Int @default(12)

  // Copy
  titleTemplate    String @default("Hi {client name}, {user name} has requested {item count} items for {template name}.")
  submittedMessage String @default("Thank you! Your documents have been securely uploaded directly to {user name}'s storage. No further action is needed.")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
